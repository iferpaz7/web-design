---
import Layout from '../layouts/Layout.astro';
import UnidadCard from '../components/UnidadCard.tsx';
import { syllabusUnits } from '../data/syllabus';

const unidades = syllabusUnits;

const stats = [
  { value: '17', label: 'semanas planificadas' },
  { value: '4', label: 'unidades formativas' },
  { value: '15', label: 'temas del curso' },
  { value: '2', label: 'exámenes bimestrales' }
];

const pillars = [
  {
    icon: '🎯',
    title: 'Estrategia y Conversión',
    description:
      'Diseño orientado a objetivos claros de negocio, embudos de captación y llamadas a la acción sin adornos innecesarios.'
  },
  {
    icon: '🚀',
    title: 'Publicación No-Code Viable',
    description:
      'Construcción y despliegue con herramientas modernas, accesibles y de bajo costo que no exigen experiencia en programación.'
  },
  {
    icon: '⚖️',
    title: 'Ética y Accesibilidad (WCAG)',
    description:
      'Compromiso con la inclusión digital de personas con discapacidad, transparencia de datos y rechazo absoluto a patrones oscuros.'
  }
];

const outcomes = [
  {
    number: '01',
    title: 'Planificar activos web orientados a conversión',
    description:
      'Definirás objetivos, público, propuesta de valor y estructura para que cada página responda a una intención clara.'
  },
  {
    number: '02',
    title: 'Prototipar experiencias claras y consistentes',
    description:
      'Trabajarás arquitectura de la información, copy persuasivo y prototipos visuales que puedan validarse antes de publicar.'
  },
  {
    number: '03',
    title: 'Publicar páginas funcionales con herramientas viables',
    description:
      'Construirás un activo web compartible usando rutas de publicación accesibles y mecanismos simples de contacto o conversión.'
  },
  {
    number: '04',
    title: 'Optimizar, medir y sustentar mejoras',
    description:
      'Cerrarás el curso con un activo optimizado, criterios básicos de SEO y medición, y un reporte ejecutivo de mejoras.'
  }
];

const reasons = [
  {
    title: 'Contenido actualizado',
    description:
      'Estructura alineada al sílabo vigente y al perfil real de estudiantes de marketing digital.'
  },
  {
    title: 'Aprendizaje aplicado',
    description:
      'Cada tema se conecta con un proyecto integrador y con evidencias concretas por unidad.'
  },
  {
    title: 'Guía y presentación',
    description:
      'El mismo contenido funciona como material de estudio y como presentación web lista para clase.'
  }
];
---

<Layout title="Diseño Web para Marketing Digital - ITSAE">
  <main class="min-h-screen text-slate-900 transition-colors duration-300 dark:text-slate-100">
    <!-- Hero Header -->
    <header class="border-b border-slate-200/80 bg-white/70 backdrop-blur-xs dark:border-slate-800/80 dark:bg-slate-950/70">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1.04fr_0.96fr] lg:items-center lg:px-8">
        <div>
          <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary-200/80 bg-primary-50/80 px-3 py-1 text-xs font-semibold text-primary-800 shadow-2xs dark:border-primary-800/80 dark:bg-primary-950/50 dark:text-primary-300">
            <span class="inline-block h-2 w-2 rounded-full bg-primary-600 animate-pulse dark:bg-primary-400"></span>
            <span>Carrera de Marketing Digital · ITSAE Ecuador</span>
          </div>

          <h1 class="max-w-3xl text-3xl leading-tight font-black tracking-tight break-words text-slate-950 min-[380px]:text-4xl sm:text-5xl lg:text-6xl dark:text-white">
            Diseño Web para Marketing Digital
          </h1>

          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl dark:text-slate-300">
            Aprende a convertir estrategia, UX/UI, prototipado y publicación
            viable en activos web claros, medibles y defendibles.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="#pensum"
              class="inline-flex items-center justify-center rounded-xl bg-primary-700 px-6 py-3.5 text-base font-bold text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-800 hover:shadow-md dark:bg-primary-600 dark:hover:bg-primary-500"
            >
              Ver temario completo
            </a>
            <a
              href="#perfil"
              class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-base font-semibold text-slate-800 shadow-2xs transition-all duration-200 hover:-translate-y-0.5 hover:border-primary-300 hover:bg-primary-50/50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-primary-700 dark:hover:bg-primary-950/30"
            >
              Revisar perfil del curso
            </a>
          </div>

          <!-- Quick Stats Cards -->
          <dl class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {stats.map((stat) => (
              <div class="rounded-xl border border-slate-200/80 bg-white/90 p-4 shadow-2xs transition-all duration-200 hover:border-primary-300 dark:border-slate-800/80 dark:bg-slate-900/90 dark:hover:border-primary-700">
                <dt class="text-3xl font-black text-primary-700 dark:text-primary-300">
                  {stat.value}
                </dt>
                <dd class="mt-1 text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
                  {stat.label}
                </dd>
              </div>
            ))}
          </dl>
        </div>

        <!-- High-fidelity Live Project Asset Showcase Mockup -->
        <div
          class="relative overflow-hidden rounded-2xl border border-slate-200/90 bg-slate-900 p-2 shadow-2xl transition-all duration-300 dark:border-slate-700/80 dark:bg-slate-900"
          aria-label="Vista previa del activo web de campaña desarrollado en el curso"
        >
          <!-- Browser Window Chrome -->
          <div class="rounded-xl bg-slate-950/80 p-2 text-slate-300">
            <div class="flex items-center justify-between border-b border-slate-800/80 pb-2.5 pt-1 px-2">
              <div class="flex items-center gap-1.5">
                <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
                <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
                <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
              </div>
              <div class="flex items-center gap-2 rounded-md bg-slate-900 px-3 py-1 text-xs text-slate-400 font-mono border border-slate-800">
                <span class="text-emerald-400">🔒</span>
                <span>campana-itsae.edu.ec/estrategia</span>
              </div>
              <div class="flex items-center gap-1 text-[11px] text-emerald-400 font-semibold bg-emerald-950/60 border border-emerald-800/50 px-2 py-0.5 rounded">
                <span>98% WCAG</span>
              </div>
            </div>

            <!-- Browser Interior - Simulated Campaign Landing Page -->
            <div class="rounded-lg bg-slate-50 p-4 text-slate-900 sm:p-5 dark:bg-slate-900 dark:text-slate-100">
              <!-- Mini Header -->
              <div class="flex items-center justify-between border-b border-slate-200 pb-3 dark:border-slate-800">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full bg-primary-600"></span>
                  <span class="text-xs font-bold tracking-tight">
                    ITSAE Marketing
                  </span>
                </div>
                <span class="rounded-full bg-primary-100 px-2.5 py-0.5 text-[10px] font-bold text-primary-800 dark:bg-primary-950 dark:text-primary-300">
                  Proyecto Integrador
                </span>
              </div>

              <!-- Mini Hero Section -->
              <div class="mt-4 grid gap-4 sm:grid-cols-[1.2fr_0.8fr]">
                <div>
                  <span class="inline-block rounded-md bg-accent-100 px-2 py-0.5 text-[10px] font-bold text-accent-900 uppercase dark:bg-accent-950/70 dark:text-accent-300">
                    Estrategia Digital
                  </span>
                  <h3 class="mt-2 text-base font-extrabold leading-snug sm:text-lg">
                    Diseño web que capta, persuade y convierte
                  </h3>
                  <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
                    Estructura clara de propuesta de valor, arquitectura sin
                    fricción y analítica veraz.
                  </p>
                  <div class="mt-3 flex items-center gap-2">
                    <span class="inline-flex rounded-lg bg-primary-700 px-3 py-1.5 text-xs font-bold text-white shadow-2xs dark:bg-primary-600">
                      Inscribirme ahora
                    </span>
                    <span class="text-[11px] font-semibold text-slate-500">
                      100% Online
                    </span>
                  </div>
                </div>

                <!-- Mini Lead Form Card Preview -->
                <div class="rounded-lg border border-slate-200 bg-white p-3 shadow-2xs dark:border-slate-800 dark:bg-slate-950">
                  <div class="text-[11px] font-bold text-slate-800 dark:text-slate-200">
                    Captación Ética de Leads
                  </div>
                  <div class="mt-2 space-y-1.5">
                    <div class="h-6 rounded bg-slate-100 px-2 text-[10px] text-slate-500 flex items-center dark:bg-slate-800">
                      nombre@estudiante.ec
                    </div>
                    <div class="h-6 rounded bg-accent-500 text-slate-950 text-[10px] font-bold flex items-center justify-center">
                      Enviar Solicitud
                    </div>
                  </div>
                  <div class="mt-2 text-[9px] text-slate-500 text-center dark:text-slate-400">
                    Protección de datos conforme a la ley
                  </div>
                </div>
              </div>

              <!-- Metrics Ticker Bar -->
              <div class="mt-4 grid grid-cols-3 gap-2 border-t border-slate-200 pt-3 text-center dark:border-slate-800">
                <div class="rounded bg-slate-100/70 p-1.5 dark:bg-slate-800/60">
                  <div class="text-xs font-black text-emerald-600 dark:text-emerald-400">
                    14.8%
                  </div>
                  <div class="text-[9px] text-slate-500 dark:text-slate-400 font-medium">
                    Conversión
                  </div>
                </div>
                <div class="rounded bg-slate-100/70 p-1.5 dark:bg-slate-800/60">
                  <div class="text-xs font-black text-primary-600 dark:text-primary-400">
                    0.8s
                  </div>
                  <div class="text-[9px] text-slate-500 dark:text-slate-400 font-medium">
                    LCP Veloz
                  </div>
                </div>
                <div class="rounded bg-slate-100/70 p-1.5 dark:bg-slate-800/60">
                  <div class="text-xs font-black text-accent-600 dark:text-accent-400">
                    AA
                  </div>
                  <div class="text-[9px] text-slate-500 dark:text-slate-400 font-medium">
                    Inclusión WCAG
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Student Profile Section -->
    <section
      id="perfil"
      class="border-b border-slate-200/80 bg-white py-14 dark:border-slate-800/80 dark:bg-slate-900/60"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-bold tracking-wider text-primary-700 uppercase dark:text-primary-300">
            Perfil del estudiante y propósito formativo
          </p>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl dark:text-white">
            Para quienes necesitan diseñar con criterio, no solo decorar
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
            Este curso está diseñado para estudiantes de marketing digital,
            emprendedores y profesionales que necesitan diseñar activos web con
            criterio estratégico, buena experiencia de usuario y una ruta de
            publicación viable. No exige programación previa ni depende de
            licencias costosas.
          </p>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          {pillars.map((pillar) => (
            <div class="rounded-xl border border-slate-200/90 bg-slate-50/70 p-6 shadow-2xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-950/60">
              <div class="text-2xl">{pillar.icon}</div>
              <h3 class="mt-3 text-lg font-bold text-slate-900 dark:text-white">
                {pillar.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {pillar.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Concrete Outcomes Section -->
    <section id="logros" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-2xl">
        <p class="text-sm font-bold tracking-wider text-primary-700 uppercase dark:text-primary-300">
          Resultados concretos de aprendizaje
        </p>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl dark:text-white">
          Qué vas a lograr al terminar el curso
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {outcomes.map((outcome) => (
          <article class="group rounded-xl border border-slate-200/90 bg-white p-6 shadow-2xs transition-all duration-200 hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/80 dark:hover:border-primary-700">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-accent-100 text-xs font-black text-accent-800 dark:bg-accent-950 dark:text-accent-300">
              {outcome.number}
            </span>
            <h3 class="mt-3 text-lg font-bold text-slate-900 dark:text-white">
              {outcome.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              {outcome.description}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- Pensum Section -->
    <section
      id="pensum"
      class="border-y border-slate-200/80 bg-white py-16 dark:border-slate-800/80 dark:bg-slate-900/60"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
          <div class="max-w-3xl">
            <p class="text-sm font-bold tracking-wider text-primary-700 uppercase dark:text-primary-300">
              Pénsum y estructura curricular
            </p>
            <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl dark:text-white">
              Contenido organizado por unidades
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
              Cada ruta temática puede usarse en dos formatos: lectura guiada
              para el estudiante y presentación interactiva para exposición
              docente.
            </p>
          </div>
          <div class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-xs font-bold text-slate-700 shadow-2xs dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300">
            <span>📚 4 unidades</span>
            <span>·</span>
            <span>🗓️ 17 semanas</span>
            <span>·</span>
            <span>🏆 Proyecto final</span>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          {unidades.map((unidad) => (
            <UnidadCard
              numero={unidad.numero}
              titulo={unidad.titulo}
              descripcion={unidad.descripcion}
              color={unidad.color}
              iconName={unidad.iconName}
              temas={unidad.temas}
              client:load
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Why it works Section -->
    <section id="por-que" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.6fr_1fr]">
        <div>
          <p class="text-sm font-bold tracking-wider text-primary-700 uppercase dark:text-primary-300">
            Enfoque formativo ITSAE
          </p>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl dark:text-white">
            Por qué esta ruta pedagógica funciona
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600 dark:text-slate-300">
            Unimos la excelencia técnica con la formación en valores cristianos,
            asegurando que cada estudiante egrese con proyectos reales
            demostrables.
          </p>
        </div>
        <div class="grid gap-5 sm:grid-cols-3">
          {reasons.map((reason) => (
            <article class="rounded-xl border border-slate-200/90 bg-white p-6 shadow-2xs transition-all duration-200 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/80">
              <h3 class="font-bold text-slate-900 dark:text-white">
                {reason.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {reason.description}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA Banner -->
    <section
      id="cta"
      class="border-t border-slate-200/80 bg-linear-to-r from-primary-900 via-primary-800 to-primary-950 text-white dark:border-slate-800"
    >
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-14 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <div class="max-w-2xl">
          <span class="inline-block rounded-md bg-white/10 px-3 py-1 text-xs font-bold text-white uppercase tracking-wider">
            Educación con propósito
          </span>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">
            Tu próximo proyecto digital empieza aquí
          </h2>
          <p class="mt-3 text-base leading-relaxed text-primary-100">
            A lo largo del período académico construirás un activo web completo,
            desde el brief estratégico hasta la optimización y sustentación
            final.
          </p>
        </div>
        <a
          href="#pensum"
          class="inline-flex items-center justify-center rounded-xl bg-accent-500 px-7 py-3.5 text-base font-extrabold text-slate-950 shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-400 hover:shadow-lg"
        >
          Explorar el temario completo
        </a>
      </div>
    </section>
  </main>
</Layout>
