---
import Layout from '../../../layouts/Layout.astro';
import TemaPresentacion from '../../../components/TemaPresentacion';
import { syllabusUnits } from '../../../data/syllabus';

export function getStaticPaths() {
  return syllabusUnits.flatMap((unit) =>
    unit.temas.map((tema) => ({
      params: {
        unidad: `unidad${unit.numero}`,
        tema: `tema${tema.numero}`
      },
      props: {
        unit,
        tema
      }
    }))
  );
}

const { unit, tema } = Astro.props;
---

<Layout
  title={`Presentación · Unidad ${unit.numero} · Tema ${tema.numero} - ITSAE`}
  hideChrome={true}
>
  <div
    class="min-h-dvh w-full overflow-x-hidden bg-gray-950 sm:h-dvh sm:w-screen sm:overflow-hidden"
  >
    <TemaPresentacion unit={unit} tema={tema} mode="standalone" client:load />
  </div>
</Layout>
