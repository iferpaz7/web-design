---
import TemaPresentacion from './TemaPresentacion';
import type { SyllabusTema, SyllabusUnit } from '../data/syllabus';
import { syllabusUnits } from '../data/syllabus';

interface Props {
  unit: SyllabusUnit;
  tema: SyllabusTema;
}

const { unit, tema } = Astro.props;

const colorStyles = {
  amber: {
    accentText: 'text-amber-500 dark:text-amber-400',
    badge:
      'bg-amber-500/15 text-amber-800 dark:text-amber-300 ring-amber-500/30',
    panel: 'bg-amber-50/60 dark:bg-amber-950/20',
    border: 'border-amber-500',
    accentLine: 'bg-amber-500',
    glow: 'bg-amber-500',
    progressBar: 'bg-amber-500'
  },
  blue: {
    accentText: 'text-sky-500 dark:text-sky-400',
    badge: 'bg-sky-500/15 text-sky-800 dark:text-sky-300 ring-sky-500/30',
    panel: 'bg-blue-50/60 dark:bg-blue-950/20',
    border: 'border-sky-500',
    accentLine: 'bg-sky-500',
    glow: 'bg-sky-500',
    progressBar: 'bg-sky-500'
  },
  emerald: {
    accentText: 'text-emerald-500 dark:text-emerald-400',
    badge:
      'bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 ring-emerald-500/30',
    panel: 'bg-emerald-50/60 dark:bg-emerald-950/20',
    border: 'border-emerald-500',
    accentLine: 'bg-emerald-500',
    glow: 'bg-emerald-500',
    progressBar: 'bg-emerald-500'
  },
  purple: {
    accentText: 'text-purple-500 dark:text-purple-400',
    badge:
      'bg-purple-500/15 text-purple-800 dark:text-purple-300 ring-purple-500/30',
    panel: 'bg-purple-50/60 dark:bg-purple-950/20',
    border: 'border-purple-500',
    accentLine: 'bg-purple-500',
    glow: 'bg-purple-500',
    progressBar: 'bg-purple-500'
  }
} as const;

const styles = colorStyles[unit.color];
const printHref = `/imprimir${tema.href}`;
const presentationHref = `/presentacion/unidad${unit.numero}/tema${tema.numero}`;

// Detect latest roadmap for this tema (if any)
const allRoadmaps = import.meta.glob('../../docs/clases/**/roadmap-*.md');
const roadmapPattern = new RegExp(
  `/unidad${unit.numero}/tema${tema.numero}/roadmap-`
);
const matchingRoadmaps = Object.keys(allRoadmaps)
  .filter((k) => roadmapPattern.test(k))
  .sort();
const latestRoadmapKey = matchingRoadmaps.at(-1);
let roadmapHref: string | null = null;
if (latestRoadmapKey) {
  const m = latestRoadmapKey.match(
    /docs\/clases\/([^/]+)\/([^/]+)\/(roadmap-[^/]+)\.md$/
  );
  if (m) roadmapHref = `/imprimir/roadmap/${m[1]}/${m[2]}/${m[3]}`;
}

// Navigation between topics (intra-unit and cross-unit)
const currentUnitIdx = syllabusUnits.findIndex((u) => u.numero === unit.numero);
const currentTemaIdx = unit.temas.findIndex((t) => t.numero === tema.numero);

const prevTema =
  currentTemaIdx > 0
    ? unit.temas[currentTemaIdx - 1]
    : currentUnitIdx > 0
      ? syllabusUnits[currentUnitIdx - 1].temas.at(-1)
      : null;

const nextTema =
  currentTemaIdx < unit.temas.length - 1
    ? unit.temas[currentTemaIdx + 1]
    : currentUnitIdx < syllabusUnits.length - 1
      ? syllabusUnits[currentUnitIdx + 1].temas[0]
      : null;

const progressPercent = Math.round((tema.numero / unit.temas.length) * 100);

const continuity = nextTema
  ? `Próximo tema: ${nextTema.titulo}.`
  : unit.numero < 4
    ? `Este tema cierra la Unidad ${unit.numero}. El siguiente paso es avanzar a la Unidad ${unit.numero + 1}.`
    : 'Este tema cierra la última unidad y prepara la presentación final y el examen bimestral.';
---

<main class="min-h-screen pb-16 text-slate-900 transition-colors duration-300 dark:text-slate-100">
  <div class="mx-auto max-w-7xl 2xl:max-w-(--breakpoint-2xl) px-4 sm:px-6 lg:px-8 xl:px-12 pt-6">
    <!-- Slim Workspace Toolbar (Directly beneath Navbar, zero visual bloat) -->
    <div class="mb-6 flex flex-col gap-3.5 pb-4 border-b border-slate-200/80 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800">
      <nav
        aria-label="Ruta de navegación"
        class="flex flex-wrap items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400"
      >
        <a
          href="/"
          class="hover:text-primary-700 dark:hover:text-primary-400 transition-colors"
        >
          Inicio
        </a>
        <span class="text-slate-400 dark:text-slate-600">/</span>
        <span class="text-slate-700 dark:text-slate-300 font-semibold">
          Unidad {unit.numero}
        </span>
        <span class="text-slate-400 dark:text-slate-600">/</span>
        <span class="text-primary-700 dark:text-primary-400 font-bold">
          Tema {tema.numero}
        </span>
      </nav>

      <div class="flex flex-wrap items-center gap-2">
        <a
          href={presentationHref}
          class="inline-flex items-center gap-1.5 rounded-lg bg-primary-700 px-3 py-1.5 text-xs font-bold text-white shadow-2xs transition-all hover:bg-primary-800 dark:bg-primary-600 dark:hover:bg-primary-500"
        >
          <span>▶</span>
          <span>Presentación completa</span>
        </a>

        {roadmapHref && (
          <a
            href={roadmapHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs transition-colors hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            <span>📋</span>
            <span>Roadmap docente</span>
          </a>
        )}

        <a
          href={printHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs transition-colors hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          <span>🖨️</span>
          <span>Imprimir PDF</span>
        </a>
      </div>
    </div>

    <!-- 2-Column Educational Platform Layout: Left Sidebar + Right Content Area -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-start">
      <!-- LEFT SIDEBAR: Pestañas de Formato (LMS Style) + Navegación de la Unidad -->
      <aside class="space-y-6 lg:col-span-4 xl:col-span-3.5 2xl:col-span-3 lg:sticky lg:top-20">
        <!-- LMS Study Mode Selector (Segmented Tab Bar) -->
        <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/95">
          <div class="mb-3 flex items-center justify-between px-1">
            <span class="text-xs font-bold tracking-wider text-slate-500 uppercase dark:text-slate-400">
              Modalidad de estudio
            </span>
            <span class="rounded-full bg-primary-100 px-2 py-0.5 text-[10px] font-bold text-primary-800 dark:bg-primary-950 dark:text-primary-300">
              Interactivo
            </span>
          </div>

          <!-- Tab Group: Horizontal on mobile, vertical stacked card on desktop -->
          <div
            role="tablist"
            aria-label="Formatos disponibles del tema"
            class="flex flex-col gap-2 sm:grid sm:grid-cols-3 lg:flex lg:flex-col"
          >
            <button
              type="button"
              data-tab="guide"
              aria-selected="true"
              class="tab-button group flex w-full items-start gap-3 rounded-xl border border-transparent p-3 text-left transition-all duration-200"
            >
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-emerald-800 font-bold dark:bg-emerald-950/80 dark:text-emerald-300">
                📖
              </div>
              <div class="min-w-0 flex-1">
                <span class="block text-xs font-bold sm:text-sm text-slate-900 dark:text-white">
                  Guía de clase
                </span>
                <span class="block text-[11px] text-slate-500 dark:text-slate-400 truncate">
                  Conceptos y objetivos
                </span>
              </div>
            </button>

            <button
              type="button"
              data-tab="presentation"
              aria-selected="false"
              class="tab-button group flex w-full items-start gap-3 rounded-xl border border-transparent p-3 text-left transition-all duration-200"
            >
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-100 text-sky-800 font-bold dark:bg-sky-950/80 dark:text-sky-300">
                🖥️
              </div>
              <div class="min-w-0 flex-1">
                <span class="block text-xs font-bold sm:text-sm text-slate-900 dark:text-white">
                  Presentación web
                </span>
                <span class="block text-[11px] text-slate-500 dark:text-slate-400 truncate">
                  Diapositivas de aula
                </span>
              </div>
            </button>

            <button
              type="button"
              data-tab="activity"
              aria-selected="false"
              class="tab-button group flex w-full items-start gap-3 rounded-xl border border-transparent p-3 text-left transition-all duration-200"
            >
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-amber-800 font-bold dark:bg-amber-950/80 dark:text-amber-300">
                ✍️
              </div>
              <div class="min-w-0 flex-1">
                <span class="block text-xs font-bold sm:text-sm text-slate-900 dark:text-white">
                  Actividad práctica
                </span>
                <span class="block text-[11px] text-slate-500 dark:text-slate-400 truncate">
                  Taller y entregables
                </span>
              </div>
            </button>
          </div>
        </div>

        <!-- Unit Syllabus Track Card (Temas de la Unidad) -->
        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900/95">
          <div class="mb-4">
            <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
              <span class="font-bold uppercase tracking-wider">
                Unidad {unit.numero}
              </span>
              <span class="font-semibold">{progressPercent}% completado</span>
            </div>
            <h3 class="mt-1 text-sm font-bold text-slate-900 dark:text-white">
              {unit.titulo}
            </h3>

            <!-- Progress Bar -->
            <div class="mt-2.5 h-1.5 w-full overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
              <div
                class={`h-full ${styles.progressBar} transition-all duration-500`}
                style={`width: ${progressPercent}%`}
              ></div>
            </div>
          </div>

          <!-- Topic List in Current Unit -->
          <nav aria-label="Temario de la unidad" class="space-y-1.5">
            {unit.temas.map((t) => {
              const isCurrent = t.numero === tema.numero;
              return (
                <a
                  href={t.href}
                  class={`flex items-center justify-between rounded-xl p-2.5 text-xs transition-all ${
                    isCurrent
                      ? 'border border-primary-300/80 bg-primary-50 font-bold text-primary-900 dark:border-primary-800/80 dark:bg-primary-950/50 dark:text-primary-200'
                      : 'text-slate-600 hover:bg-slate-50 dark:text-slate-400 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white'
                  }`}
                >
                  <div class="flex items-center gap-2.5 min-w-0 pr-2">
                    <span
                      class={`flex h-6 w-6 shrink-0 items-center justify-center rounded-md text-[10px] font-bold ${
                        isCurrent
                          ? 'bg-primary-600 text-white dark:bg-primary-500'
                          : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400'
                      }`}
                    >
                      {t.numero}
                    </span>
                    <span class="truncate">{t.titulo}</span>
                  </div>
                  {isCurrent && (
                    <span class="shrink-0 rounded-full bg-primary-200/80 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-primary-800 dark:bg-primary-900 dark:text-primary-300">
                      Actual
                    </span>
                  )}
                </a>
              );
            })}
          </nav>
        </div>

        <!-- Academic Info Card -->
        <div class="rounded-2xl border border-slate-200/90 bg-slate-50/60 p-5 dark:border-slate-800 dark:bg-slate-900/60">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Ficha Curricular
          </h4>
          <dl class="mt-3 space-y-3 text-xs">
            <div>
              <dt class="font-semibold text-slate-700 dark:text-slate-300">
                Carrera:
              </dt>
              <dd class="text-slate-500 dark:text-slate-400">
                Marketing y Comercio Electrónico
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-700 dark:text-slate-300">
                Duración de clase:
              </dt>
              <dd class="text-slate-500 dark:text-slate-400">
                120 minutos sincrónicos
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-700 dark:text-slate-300">
                Calificación sugerida:
              </dt>
              <dd class="text-slate-500 dark:text-slate-400">
                10 puntos (Rúbrica SGA)
              </dd>
            </div>
          </dl>
        </div>
      </aside>

      <!-- RIGHT COLUMN: Main Dynamic Learning Content Area -->
      <section class="space-y-6 lg:col-span-8 xl:col-span-8.5 2xl:col-span-9 min-w-0">
        <!-- Topic Heading Header (Shown in Guide and Activity views, hidden in Presentation view to avoid duplicate titles) -->
        <header id="topic-header" class="space-y-2 pb-2">
          <div class="flex flex-wrap items-center gap-2">
            <span
              class={`inline-flex items-center gap-1.5 rounded-full px-3 py-0.5 text-xs font-bold ring-1 ${styles.badge}`}
            >
              Unidad {unit.numero} · Tema {tema.numero}
            </span>
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
              {unit.titulo}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
            {tema.titulo}
          </h1>

          <p class="text-sm text-slate-600 dark:text-slate-400">
            Diseño Web para Marketing Digital · ITSAE Ecuador · Modalidad
            virtual sincrónica
          </p>
        </header>

        <!-- ========================================== -->
        <!-- VIEW 1: GUÍA DE CLASE                      -->
        <!-- ========================================== -->
        <div data-topic-view="guide" class="space-y-8">
          <!-- Panorama General Card -->
          <article class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-8 dark:border-slate-800 dark:bg-slate-900/95">
            <div class="mb-5 flex flex-wrap items-center gap-2">
              <span class="rounded-full bg-primary-50 px-3 py-1 text-xs font-bold text-primary-800 dark:bg-primary-950 dark:text-primary-300">
                Sílabo Vigente 2026-2027
              </span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                Unidad {unit.numero}
              </span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                Diseño Web para Marketing
              </span>
            </div>

            <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl dark:text-white">
              Panorama general
            </h2>

            <p class="mt-4 text-base leading-relaxed text-slate-700 sm:text-lg dark:text-slate-200">
              {tema.panorama}
            </p>

            <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              {tema.descripcion}
            </p>

            <!-- Pedagogical Callout Box -->
            <div class="mt-6 rounded-xl border border-slate-200/80 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950/60">
              <div class="flex items-start gap-3">
                <span class="text-lg">🎯</span>
                <div class="text-xs leading-relaxed text-slate-600 dark:text-slate-300">
                  <strong class="font-bold text-slate-900 dark:text-white">
                    Propósito de la sesión:
                  </strong>{' '}
                  Comprender cómo este activo digital se articula dentro del
                  ecosistema de marketing y asegura una experiencia libre de
                  barreras para el usuario final.
                </div>
              </div>
            </div>
          </article>

          <!-- 2-Column Grid: Objetivos de Aprendizaje & Ideas Clave -->
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <!-- Learning Objectives -->
            <article class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-7 dark:border-slate-800 dark:bg-slate-900/95">
              <div class="mb-4 flex items-center gap-2.5">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-800 font-bold dark:bg-emerald-950 dark:text-emerald-300">
                  ✓
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                  Objetivos de aprendizaje
                </h3>
              </div>
              <ul class="space-y-3">
                {tema.objetivos.map((objetivo) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                    <span>{objetivo}</span>
                  </li>
                ))}
              </ul>
            </article>

            <!-- Key Ideas -->
            <article class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-7 dark:border-slate-800 dark:bg-slate-900/95">
              <div class="mb-4 flex items-center gap-2.5">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent-100 text-accent-800 font-bold dark:bg-accent-950 dark:text-accent-300">
                  💡
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                  Ideas clave del tema
                </h3>
              </div>
              <ul class="space-y-3">
                {tema.ideasClave.map((idea) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span>
                    <span>{idea}</span>
                  </li>
                ))}
              </ul>
            </article>
          </div>

          <!-- Curricular Alignment Card -->
          <article class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-8 dark:border-slate-800 dark:bg-slate-900/95">
            <h2 class="text-xl font-bold text-slate-900 sm:text-2xl dark:text-white">
              Alineación curricular con la Unidad {unit.numero}
            </h2>
            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div class="rounded-xl border border-slate-200/80 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950/60">
                <span class="text-xs font-bold text-primary-700 uppercase dark:text-primary-300">
                  Capacidad esperada
                </span>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                  {unit.capacidad}
                </p>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950/60">
                <span class="text-xs font-bold text-emerald-700 uppercase dark:text-emerald-400">
                  Evidencia institucional
                </span>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                  {unit.evidencia}
                </p>
              </div>
            </div>
          </article>

          <!-- Continuity & Next Steps Card -->
          <article
            class={`rounded-2xl border border-slate-200/90 p-6 sm:p-8 dark:border-slate-800 ${styles.panel}`}
          >
            <h2 class="text-xl font-bold text-slate-900 sm:text-2xl dark:text-white">
              Continuidad pedagógica
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
              Este contenido está alineado con el sílabo actualizado del curso y
              con una secuencia de trabajo que prioriza estrategia, prototipado,
              publicación viable y mejora continua.
            </p>
            <p class="mt-2 text-sm font-semibold text-primary-800 dark:text-primary-300">
              {continuity}
            </p>

            <!-- Previous / Next Navigation Strip -->
            <div class="mt-6 flex flex-col gap-3 border-t border-slate-200/80 pt-5 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800">
              {prevTema ? (
                <a
                  href={prevTema.href}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
                >
                  <span>←</span>
                  <span>Tema anterior: {prevTema.titulo}</span>
                </a>
              ) : (
                <span class="text-xs text-slate-400">Inicio del módulo</span>
              )}

              {nextTema && (
                <a
                  href={nextTema.href}
                  class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-primary-700 px-4 py-2 text-xs font-bold text-white shadow-2xs transition-all hover:bg-primary-800 dark:bg-primary-600 dark:hover:bg-primary-500"
                >
                  <span>Siguiente tema</span>
                  <span>→</span>
                </a>
              )}
            </div>
          </article>
        </div>

        <!-- ========================================== -->
        <!-- VIEW 2: ACTIVIDAD PRÁCTICA                 -->
        <!-- ========================================== -->
        <div data-topic-view="activity" class="hidden space-y-8">
          <!-- Suggested Activity Card -->
          <article class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-8 dark:border-slate-800 dark:bg-slate-900/95">
            <div class="mb-3 inline-block rounded-md bg-primary-100 px-2.5 py-1 text-xs font-bold text-primary-800 dark:bg-primary-950 dark:text-primary-300">
              Taller de Aplicación · Ponderación 10 pts
            </div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl dark:text-white">
              Actividad práctica sugerida
            </h2>
            <p class="mt-4 text-base leading-relaxed text-slate-700 dark:text-slate-300">
              {tema.actividad}
            </p>
          </article>

          <!-- Evidence Criteria Card -->
          <article class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-8 dark:border-slate-800 dark:bg-slate-900/95">
            <h2 class="text-xl font-bold text-slate-900 sm:text-2xl dark:text-white">
              Criterio de evidencia y entrega
            </h2>
            <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm leading-relaxed text-slate-700 dark:border-slate-800 dark:bg-slate-950/60 dark:text-slate-300">
              {tema.evidencia}
            </div>

            <!-- Submission instructions checklist -->
            <div class="mt-5 space-y-2.5">
              <div class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>
                  Entrega a través del portal de Google Classroom asignado al
                  curso.
                </span>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>
                  Adjuntar enlaces funcionales (Figma / Web pública /
                  Repositorio) con permisos de lectura.
                </span>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>
                  Cumplir con la fecha límite especificada en el cronograma
                  académico.
                </span>
              </div>
            </div>
          </article>

          <!-- Tools and Recommended Resources -->
          <article class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-8 dark:border-slate-800 dark:bg-slate-900/95">
            <h2 class="text-xl font-bold text-slate-900 sm:text-2xl dark:text-white">
              Herramientas y recursos recomendados
            </h2>
            <div class="mt-5 grid grid-cols-1 gap-3.5 sm:grid-cols-2">
              {tema.herramientas.map((herramienta) => (
                <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50/80 p-4 transition-colors hover:border-primary-300 dark:border-slate-800 dark:bg-slate-950/60 dark:hover:border-primary-700">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary-100 text-xs font-bold text-primary-800 dark:bg-primary-950 dark:text-primary-300">
                    🛠️
                  </span>
                  <p class="text-xs font-semibold text-slate-800 sm:text-sm dark:text-slate-200">
                    {herramienta}
                  </p>
                </div>
              ))}
            </div>
          </article>
        </div>

        <!-- ========================================== -->
        <!-- VIEW 3: PRESENTACIÓN WEB INTERACTIVA       -->
        <!-- ========================================== -->
        <div data-topic-view="presentation" class="hidden">
          <TemaPresentacion unit={unit} tema={tema} client:load />
        </div>
      </section>
    </div>
  </div>
</main>

<script>
  const guideSection = document.querySelector<HTMLElement>(
    '[data-topic-view="guide"]'
  );
  const presentationSection = document.querySelector<HTMLElement>(
    '[data-topic-view="presentation"]'
  );
  const activitySection = document.querySelector<HTMLElement>(
    '[data-topic-view="activity"]'
  );
  const topicHeader = document.getElementById('topic-header');
  const tabButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-tab]')
  );

  const setActiveTab = (tab: 'guide' | 'presentation' | 'activity') => {
    guideSection?.classList.toggle('hidden', tab !== 'guide');
    presentationSection?.classList.toggle('hidden', tab !== 'presentation');
    activitySection?.classList.toggle('hidden', tab !== 'activity');

    // In presentation view, hide the external topic header to avoid title duplication
    topicHeader?.classList.toggle('hidden', tab === 'presentation');

    tabButtons.forEach((button) => {
      const isActive = button.dataset.tab === tab;
      button.setAttribute('aria-selected', isActive ? 'true' : 'false');

      // Visual active styles for LMS tab button
      button.classList.toggle('bg-white', isActive);
      button.classList.toggle('dark:bg-slate-800', isActive);
      button.classList.toggle('text-slate-900', isActive);
      button.classList.toggle('dark:text-white', isActive);
      button.classList.toggle('shadow-sm', isActive);
      button.classList.toggle('border-primary-500', isActive);
      button.classList.toggle('dark:border-primary-400', isActive);
      button.classList.toggle('ring-1', isActive);
      button.classList.toggle('ring-primary-500/30', isActive);

      button.classList.toggle('bg-transparent', !isActive);
      button.classList.toggle('text-slate-600', !isActive);
      button.classList.toggle('dark:text-slate-400', !isActive);
      button.classList.toggle('border-transparent', !isActive);
      button.classList.toggle('ring-0', !isActive);
    });

    const params = new URLSearchParams(window.location.search);
    params.set('tab', tab);
    const query = params.toString();
    const nextUrl = `${window.location.pathname}${query ? `?${query}` : ''}`;
    window.history.replaceState({}, '', nextUrl);
  };

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedTab =
        button.dataset.tab === 'presentation'
          ? 'presentation'
          : button.dataset.tab === 'activity'
            ? 'activity'
            : 'guide';
      setActiveTab(selectedTab);
    });
  });

  const initialTab =
    (new URLSearchParams(window.location.search).get('tab') as
      'guide' | 'presentation' | 'activity') || 'guide';
  setActiveTab(initialTab);
</script>
