---
interface Props {
  Content: any;
  unidad: string;
  tema: string;
  filename: string;
}

const { Content, unidad, tema, filename } = Astro.props;

// roadmap-2026-05-04 → 2026-05-04
const fecha = filename.replace('roadmap-', '');

// unidad1 → 1, tema2 → 2
const unidadNum = unidad.replace('unidad', '');
const temaNum = tema.replace('tema', '');

const guiaHref = `/unidad${unidadNum}/tema${temaNum}`;
const presentacionHref = `/presentacion/unidad${unidadNum}/tema${temaNum}`;
---

<main class="bg-white text-gray-900">
  <section
    data-print-toolbar
    class="sticky top-0 z-10 border-b border-gray-200 bg-white/95 backdrop-blur print:hidden"
  >
    <div
      class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p
          class="text-xs font-semibold tracking-[0.24em] text-gray-500 uppercase"
        >
          Roadmap docente
        </p>
        <h1 class="mt-1 text-lg font-bold text-gray-900">
          Unidad {unidadNum} · Tema {temaNum} · {fecha}
        </h1>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={guiaHref}
          class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:border-gray-400 hover:bg-gray-50"
        >
          Guía del tema
        </a>
        <a
          href={presentacionHref}
          class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:border-gray-400 hover:bg-gray-50"
        >
          Presentación
        </a>
        <button
          type="button"
          data-print-action
          class="rounded-full bg-gray-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-gray-700"
        >
          Imprimir o guardar PDF
        </button>
      </div>
    </div>
  </section>

  <article
    class="roadmap-prose mx-auto max-w-5xl px-6 py-8 sm:py-12 print:max-w-none print:px-0 print:py-0"
  >
    <Content />
  </article>
</main>

<script>
  const printButton = document.querySelector<HTMLButtonElement>(
    '[data-print-action]'
  );
  printButton?.addEventListener('click', () => window.print());
</script>

<style is:inline>
  @page {
    size: A4;
    margin: 16mm;
  }

  @media print {
    html,
    body {
      background: #ffffff !important;
      color: #111827 !important;
    }

    [data-print-toolbar] {
      display: none !important;
    }

    article {
      max-width: none !important;
    }
  }

  /* Prose styles for rendered markdown */
  .roadmap-prose h1 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .roadmap-prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .roadmap-prose h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: #374151;
    margin-top: 1.5rem;
    margin-bottom: 0.4rem;
  }

  .roadmap-prose h4 {
    font-size: 0.95rem;
    font-weight: 600;
    color: #4b5563;
    margin-top: 1.25rem;
    margin-bottom: 0.35rem;
  }

  .roadmap-prose p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #374151;
    margin-bottom: 0.75rem;
  }

  .roadmap-prose ul,
  .roadmap-prose ol {
    padding-left: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .roadmap-prose li {
    font-size: 0.9rem;
    line-height: 1.65;
    color: #374151;
    margin-bottom: 0.2rem;
  }

  .roadmap-prose ul > li {
    list-style-type: disc;
  }

  .roadmap-prose ol > li {
    list-style-type: decimal;
  }

  .roadmap-prose strong {
    font-weight: 600;
    color: #111827;
  }

  .roadmap-prose em {
    font-style: italic;
    color: #4b5563;
  }

  .roadmap-prose blockquote {
    border-left: 3px solid #d1d5db;
    padding-left: 1rem;
    margin: 1rem 0;
    color: #4b5563;
    font-style: italic;
    font-size: 0.9rem;
  }

  .roadmap-prose hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 1.5rem 0;
  }

  .roadmap-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    margin-bottom: 1rem;
    break-inside: avoid;
  }

  .roadmap-prose th {
    background-color: #f9fafb;
    font-weight: 600;
    color: #111827;
    padding: 0.5rem 0.75rem;
    text-align: left;
    border: 1px solid #e5e7eb;
  }

  .roadmap-prose td {
    padding: 0.5rem 0.75rem;
    border: 1px solid #e5e7eb;
    color: #374151;
    vertical-align: top;
  }

  .roadmap-prose tr:nth-child(even) td {
    background-color: #f9fafb;
  }

  .roadmap-prose code {
    background-color: #f3f4f6;
    border-radius: 3px;
    padding: 0.15em 0.35em;
    font-size: 0.85em;
    color: #1f2937;
  }

  @media print {
    .roadmap-prose h2 {
      margin-top: 1.25rem;
      break-after: avoid;
    }

    .roadmap-prose h3,
    .roadmap-prose h4 {
      break-after: avoid;
    }

    .roadmap-prose table {
      break-inside: avoid;
    }

    .roadmap-prose a[href]::after {
      content: ' (' attr(href) ')';
      font-size: 0.75em;
      color: #6b7280;
      word-break: break-all;
      font-style: normal;
    }
  }
</style>
